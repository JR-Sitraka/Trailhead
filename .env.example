# PostgreSQL connection strings — two separate databases required.
# See KNOWN-GOOD.md for the real, tested local setup procedure
# (PostgreSQL 17 + pgvector, compiled from source).
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/trailhead_dev
TEST_DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/trailhead_test

# Groq API key (generation provider for Ask/Chat/Export).
# Get one free at console.groq.com — no card required.
GROQ_API_KEY=

# GitHub personal access token (optional but recommended).
# Without it: GitHub imports work but are rate-limited to 60 req/hour.
# With it: 5,000 req/hour, and private-repo detection works correctly.
# Create a fine-grained token at github.com/settings/tokens with
# Repository access: All repositories, Permissions: Contents
# (Read-only) + Metadata (Read-only). See KNOWN-GOOD.md for details.
GITHUB_TOKEN=
